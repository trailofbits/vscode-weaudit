{
    "all": true,
    "require": ["ts-node/register/transpile-only"],
    "include": ["src/**/*.ts"],
    "exclude": ["src/**/*.d.ts", "src/webview/**/*.ts", "src/test/**/*.ts", "test/**/*.ts"],
    "extension": [".ts"],
    "reporter": ["text", "text-summary", "html", "lcov", "json-summary"],
    "report-dir": "coverage/unit",
    "temp-dir": ".nyc_output/unit",
    "check-coverage": false,
    "per-file": false,
    "watermarks": {
        "lines": [60, 80],
        "functions": [60, 80],
        "branches": [60, 80],
        "statements": [60, 80]
    }
}
